# Copia este archivo como functions/.env y completa los valores.
# functions/.env NO se sube a Git (está en .gitignore).

# Servidor SMTP (por defecto Gmail). Con Gmail: crea una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (requiere verificación en dos pasos).
# Conviene usar una cuenta dedicada al proyecto, no tu Gmail personal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Remitente (en Gmail debe ser la misma cuenta de SMTP_USER) y correo del encargado
MAIL_FROM=
MAIL_TO=

# Quién puede usar la bandeja del funcionario (cambiar estados, observar, atender).
# Correos separados por coma; deben ser cuentas registradas en la aplicación con el correo verificado.
# Si no se define, solo MAIL_TO tiene acceso.
FUNCIONARIOS=

# Token de miapi.cloud para consultar nombres por DNI
MIAPI_TOKEN=
